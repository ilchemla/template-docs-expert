# Gateway — single key proxies to OpenAI, Anthropic, Google, etc.
# https://mastra.ai/docs/models/gateways/mastra
MASTRA_GATEWAY_API_KEY=

# Turso (libSQL) — used for observability + observational memory
# Create a database at https://turso.tech, then copy the URL + auth token.
# Example: libsql://my-db.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: model router id for the agent, e.g. mastra/openai/gpt-6.1-terra or
# mastra/anthropic/claude-sonnet-5-5. Defaults to mastra/openai/gpt-6.1-terra.
AGENT_MODEL=

# Optional local Python MCP tools. Default remains gateway.
DOCS_WEB_PROVIDER=gateway
# Absolute paths. Provider credentials belong in WEB_ROUTER_ENV_FILE.
WEB_ROUTER_PROJECT=
WEB_ROUTER_ENV_FILE=
